rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own products
    // Public read allowed for sharing product pages
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own templates
    match /templates/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own master_videos
    match /master_videos/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own video_variations
    match /video_variations/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own sessions
    match /sessions/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own renders
    // n8n also needs to update renders (status, videoUrl) using a service account
    match /renders/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.userId || request.resource.data.keys().hasOnly(['status', 'videoUrl', 'updatedAt']));
    }

    // User preferences (timezone, etc.) — each user owns their own doc
    match /user_prefs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Calendar strategy — free-text posting strategy. One doc per CONTAINER: the general
    // container keeps the doc id as `{userId}` (unchanged, so every doc written before
    // containers existed keeps working with zero migration), and a per-TikTok-account
    // container appends the account's openId as `{userId}__{accountId}` — see
    // `containerDocId()` in databaseService.ts. The rule only needs the userId half to
    // validate ownership, so it splits the id on '__' and checks the first segment: a user
    // can never read/write another user's doc no matter what accountId suffix they pick.
    match /calendar_strategy/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == docId.split('__')[0];
    }

    // Analytics: imported TikTok Shop order lines — one doc per Order ID + SKU ID,
    // path-scoped by userId (no resource.data.userId to check on create, since the
    // path segment already pins the owner).
    match /analytics_orders/{userId}/orders/{orderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Scheduled renders — each user owns their own jobs
    match /scheduled_renders/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Brand Concept — one doc per CONTAINER with the channel's art direction (description,
    // niche, style, colors, fonts, moodboard images). Same composite-id scheme as
    // calendar_strategy above: `{userId}` for the general container, `{userId}__{accountId}`
    // for an account container, validated by splitting on '__' and checking the first segment.
    match /brand_concepts/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == docId.split('__')[0];
    }

    // Reports: LLM-generated performance reports — one doc per report under
    // a per-user history subcollection, path-scoped by userId like
    // analytics_orders (no resource.data.userId to check on create).
    match /reports/{userId}/history/{reportId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // TikTok tokens (Phase 6) — only Cloud Functions touch this collection (Admin SDK
    // bypasses these rules). The client must never read it directly: anyone holding a
    // token could publish to that user's TikTok account from outside the app. The
    // frontend gets the non-sensitive account list via the tiktokAccounts function.
    match /tiktok_accounts/{docId} {
      allow read, write: if false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
