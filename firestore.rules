rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own products
    // Public read allowed for sharing product pages
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own templates
    match /templates/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own master_videos
    match /master_videos/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own video_variations
    match /video_variations/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own sessions
    match /sessions/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Allow authenticated users to read/write their own renders
    // n8n also needs to update renders (status, videoUrl) using a service account
    match /renders/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.userId || request.resource.data.keys().hasOnly(['status', 'videoUrl', 'updatedAt']));
    }

    // User preferences (timezone, etc.) — each user owns their own doc
    match /user_prefs/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Calendar strategy — free-text posting strategy, one doc per user
    match /calendar_strategy/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Analytics: imported TikTok Shop order lines — one doc per Order ID + SKU ID,
    // path-scoped by userId (no resource.data.userId to check on create, since the
    // path segment already pins the owner).
    match /analytics_orders/{userId}/orders/{orderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Scheduled renders — each user owns their own jobs
    match /scheduled_renders/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
