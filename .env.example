# Credenciales del proyecto de Firebase `ttchop2`.
# Copiar a `.env` y completar. `.env` está en .gitignore — nunca commitear valores reales.
# Estas variables son públicas por naturaleza (viajan en el bundle del cliente); el control de
# acceso real vive en firestore.rules y storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
